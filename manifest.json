{
  "manifest_version": 3,
  "name": "EYOA",
  "short_name": "EYOA",
  "version": "1.0.0",
  "description": "A side-panel browser agent that uses the AI of your choice (Gemini, Claude, ChatGPT and more) to get things done: open pages, click, fill in forms and read content.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open EYOA",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": ["sidePanel", "storage", "tabs", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"]
}
